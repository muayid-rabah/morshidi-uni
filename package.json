{
  "name": "morshidi-university-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build:portal": "tsc -p tsconfig.json && vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "build": "npm run build:portal && npm run build:server",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "test:server": "tsx --test server/*.test.ts api/*.test.ts",
    "preview": "vite preview",
    "export:data": "node scripts/export_sandbox_contract.cjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.2.0",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
