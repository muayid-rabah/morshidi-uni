{
  "buildCommand": "npm run build:portal",
  "outputDirectory": "dist",
  "functions": {
    "api/university.ts": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/university?path=:path*" },
    { "source": "/healthz", "destination": "/api/university?path=healthz" }
  ]
}
